{
  "$schema": "https://github.com",

  "logo": {
    "type": "file",
    "source": "/home/eli/.config/fastfetch/logo.txt",
    "color": {
      "1": "#b4befe",
      "2": "#b4befe",
      "3": "#b4befe"
    },
    "padding": {
      "right": 2
    }
  },
  
  "display": {
    "separator": " ─※ ·❆· ※─ "
  },
  
  "modules": [
    {
      "type": "custom",
      "format": "{##b4befe}╭─ [Software]"
    },
    {
      "type": "os",
      "key": "├─ OS",
      "keyColor": "#b4befe"
    },
    {
      "type": "kernel",
      "key": "├─ Kernel",
      "keyColor": "#b4befe"
    },
    {
      "type": "shell",
      "key": "├─ Shell",
      "keyColor": "#b4befe"
    },
    {
      "type": "terminal",
      "key": "╰─ Terminal",
      "keyColor": "#b4befe"
    },

    {
      "type": "custom",
      "format": "{##b4befe}╭─ [Hardware]"
    },
    {
      "type": "cpu",
      "key": "├─ CPU",
      "keyColor": "#b4befe"
    },
    {
      "type": "gpu",
      "key": "├─ GPU",
      "keyColor": "#b4befe"
    },
    {
      "type": "memory",
      "key": "╰─ RAM",
      "keyColor": "#b4befe"
    }
  ]
}
